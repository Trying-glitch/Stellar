	end)
	-- ★ single live source of truth — every hook closure reads this at call time
	if not getgenv()._ZX_SPOOF_DEVICE then
		getgenv()._ZX_SPOOF_DEVICE = (loaded and Stellar.device_spoofer.__device) or "Phone"
	end
	return loaded
end

