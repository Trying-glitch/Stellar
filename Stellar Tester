local CollectionService = game:GetService("CollectionService")

local KNOWN_EFFECT_PATHS = {
	"Impact/Glow2Sided",
	"Impact/flare2",
	"Impact/circles",
	"Impact/fast-burst",
	"Impact/impact",
	"Star",
