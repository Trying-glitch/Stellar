								hookedFuncs[ourFunc] = true
								local entry = { orig = v, origFn = func, wrapFn = ourFunc }
								entry.wrap = remote.OnClientEvent:Connect(ourFunc)
								installed[remoteName] = installed[remoteName] or {}
