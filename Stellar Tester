		icon.Image = self:get_icon(self.__fake_value)
		icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
		icon.Visible = true

		local value = main:FindFirstChild("Value")
		if not value then
			value = Instance.new("TextLabel")
